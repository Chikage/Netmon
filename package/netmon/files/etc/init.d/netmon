#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	config_load netmon
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	# Existing flows may lack accounting extensions; never flush user connections.
	[ ! -e /proc/sys/net/netfilter/nf_conntrack_acct ] || echo 1 > /proc/sys/net/netfilter/nf_conntrack_acct
	[ ! -e /proc/sys/net/netfilter/nf_conntrack_events ] || echo 1 > /proc/sys/net/netfilter/nf_conntrack_events
	procd_open_instance
	procd_set_param command /usr/bin/python3 -B /usr/lib/netmon/daemon.py --daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger netmon network dhcp firewall
}
